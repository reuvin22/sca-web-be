NODE_ENV=development
PORT=3000
CACHE_TTL_SECONDS=60

# 64 hex characters (32 bytes). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Auth. Generate a secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Frontend URL (CORS + links in verification/reset emails)
CLIENT_URL=http://localhost:5173

# Firebase service account JSON (Firebase console > Project settings > Service accounts > Generate new private key).
# Path is relative to the sca-be folder. Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=sca.json
# Or, on hosts without secret files (DigitalOcean), the whole JSON on one line instead of the path:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Brevo transactional email (Brevo > SMTP & API > API keys). The sender email must be a verified sender in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SCA System

# Cloudflare R2 (dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sca-files
